# Copy this file to .env and fill in the keys you want to use.
# Everything is optional: the core pipeline (prices + backtest + API) works with no keys set.

# Macro series via FRED (macro ingestion)
FRED_API_KEY=

# LLM narration for /turbulence/why (endpoint falls back gracefully if unset)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# News search for /turbulence/why (falls back gracefully if unset)
TAVILY_API_KEY=

# Paths (sensible defaults shown)
DATA_DIR=data
FEATURE_STORE_PATH=data/processed/features_expanded.duckdb
FORECAST_CKPT_PATH=checkpoints/forecast.pt

# Logging / reproducibility
LOG_LEVEL=INFO
RANDOM_SEED=42
