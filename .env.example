# Copy to .env and fill in. NEVER commit the real .env.

# FRED (macro data) - https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Reddit (PRAW) - https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=turballoc/0.1 by u/your_username

# News (NewsAPI free tier) - https://newsapi.org/  (optional; GDELT needs no key)
NEWSAPI_KEY=

# Storage / runtime
DATA_DIR=data
FEATURE_STORE_PATH=data/processed/features.duckdb
LOG_LEVEL=INFO
RANDOM_SEED=42
